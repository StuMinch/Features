DEVELOPMENT_TEAM = FZ477BG7U9

// Only force manual signing + a specific profile on the "Features" app target.
// All other targets (SPM packages) fall through to their existing/automatic settings.
CODE_SIGN_STYLE = $(CODE_SIGN_STYLE_$(TARGET_NAME))
CODE_SIGN_STYLE_Features = Manual

CODE_SIGN_IDENTITY = $(CODE_SIGN_IDENTITY_$(TARGET_NAME))
CODE_SIGN_IDENTITY_Features = Apple Distribution

PROVISIONING_PROFILE_SPECIFIER = $(PROVISIONING_PROFILE_SPECIFIER_$(TARGET_NAME))
PROVISIONING_PROFILE_SPECIFIER_Features = YOUR_EXACT_PROFILE_NAME
